---
// BaseLayout.astro
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  type?: 'website' | 'article';
}

const props = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="impact-site-verification" value="00613d71-f58c-426b-b1e2-6d577ba9ffd2" />

    <!-- Travelpayouts Drive (Deferred for performance) -->
    <script is:inline>
      window.addEventListener('load', function () {
        setTimeout(function() {
          var script = document.createElement("script");
          script.async = true;
          script.src = 'https://tpembars.com/MjE4NDAz.js?t=218403';
          document.head.appendChild(script);
        }, 1500);
      });
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/hmt-icon.svg" />

    <!-- RSS Feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="HotMamaTravel RSS Feed"
      href="/rss.xml"
    />

    <!-- SEO Meta Tags -->
    <SEO {...props} />

    <!-- Preconnect & Non-blocking Google Fonts for PageSpeed -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,800;1,700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,800;1,700&display=swap" />
    </noscript>

    <!-- Google Analytics 4 (Deferred for Mobile Performance) -->
    <script is:inline>
      window.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-KJGJ8RNN9E';
          document.head.appendChild(s);
          
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-KJGJ8RNN9E');
        }, 2000);
      });
    </script>


  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      function setupOutboundLinks() {
        const links = document.querySelectorAll('a');
        links.forEach(link => {
          const href = link.getAttribute('href');
          if (!href) return;
          
          const isAffiliate = href.startsWith('/go/');
          const isExternal = href.startsWith('http://') || href.startsWith('https://');
          const isSameDomain = isExternal && href.includes(window.location.hostname);
          
          if (isAffiliate || (isExternal && !isSameDomain)) {
            link.setAttribute('target', '_blank');
            link.setAttribute('rel', 'noopener noreferrer');
          } else {
            if (link.getAttribute('target') === '_blank') {
              link.removeAttribute('target');
              link.removeAttribute('rel');
            }
          }
        });
      }

      function handleHashLinks() {
        const hash = window.location.hash;
        if (hash) {
          // Delay slightly to allow page load/render to settle
          setTimeout(() => scrollToAnchor(hash), 150);
        }

        document.body.addEventListener('click', (e) => {
          const link = e.target.closest('a');
          if (!link) return;
          
          const href = link.getAttribute('href');
          if (href && href.startsWith('#')) {
            e.preventDefault();
            const targetHash = href;
            history.pushState(null, '', targetHash);
            scrollToAnchor(targetHash);
          }
        });
      }

      function scrollToAnchor(hash) {
        const cleanHash = decodeURIComponent(hash.substring(1)).toLowerCase().trim();
        if (!cleanHash) return;

        let target = document.getElementById(cleanHash) || document.querySelector(`[name="${cleanHash}"]`);
        
        if (!target) {
          const headings = document.querySelectorAll('h2, h3, h4');
          for (const heading of headings) {
            const headingText = heading.textContent.toLowerCase().replace(/[^a-z0-9\s-]/g, '').trim().replace(/\s+/g, '-').replace(/-+/g, '-');
            const cleanText = heading.textContent.toLowerCase().trim();
            if (headingText === cleanHash || headingText.includes(cleanHash) || cleanHash.includes(headingText) || cleanText.includes(cleanHash.replace(/-/g, ' '))) {
              target = heading;
              break;
            }
          }
        }

        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          setupOutboundLinks();
          handleHashLinks();
        });
      } else {
        setupOutboundLinks();
        handleHashLinks();
      }
    </script>


  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 16px;
    background: var(--hmt-red);
    color: white;
    padding: 8px 16px;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    font-weight: 700;
    font-size: 0.875rem;
    z-index: 9999;
    transition: top 200ms;
  }
  .skip-link:focus { top: 0; }
</style>
