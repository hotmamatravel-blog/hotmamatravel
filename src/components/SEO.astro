---
// SEO.astro — Centralized SEO meta tags for every page
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  type?: 'website' | 'article';
}

const {
  title,
  description,
  image = '/images/hmt-og-default.jpg',
  canonicalUrl,
  pubDate,
  updatedDate,
  author = 'Amanda Keeley-Thurman',
  tags = [],
  type = 'website',
} = Astro.props;

const pubDateObj = pubDate
  ? (typeof pubDate === 'string'
    ? new Date(pubDate.includes('T') ? pubDate : pubDate + 'T12:00:00')
    : pubDate)
  : undefined;

const updatedDateObj = updatedDate
  ? (typeof updatedDate === 'string'
    ? new Date(updatedDate.includes('T') ? updatedDate : updatedDate + 'T12:00:00')
    : updatedDate)
  : undefined;

const fallbackDescription = 'Family travel with a twist! HotMamaTravel helps parents explore the world with their kids—from haunted hotels to kid-friendly breweries—without losing their Saturday-night selves.';
const finalDescription = (description && description.trim() !== '') ? description.trim() : fallbackDescription;

const siteUrl = 'https://hotmamatravel.com';
const resolvedCanonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
const finalImage = image || '/images/hmt-og-default.jpg';
const resolvedImage = finalImage.startsWith('http') ? finalImage : new URL(finalImage, siteUrl).href;
const fullTitle = title === 'HotMamaTravel'
  ? 'HotMamaTravel | Family Travel with a Twist'
  : `${title} | HotMamaTravel`;
---

<!-- Primary Meta -->
<title>{fullTitle}</title>
<meta name="description" content={finalDescription} />
<meta name="author" content={author} />
{tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
<link rel="canonical" href={resolvedCanonical} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={finalDescription} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="HotMamaTravel" />
<meta property="og:locale" content="en_US" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@hotmamatravel" />
<meta name="twitter:creator" content="@hotmamatravel" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={finalDescription} />
<meta name="twitter:image" content={resolvedImage} />

<!-- Article-specific meta -->
{type === 'article' && pubDateObj && (
  <meta property="article:published_time" content={pubDateObj.toISOString()} />
)}
{type === 'article' && updatedDateObj && (
  <meta property="article:modified_time" content={updatedDateObj.toISOString()} />
)}
{type === 'article' && (
  <meta property="article:author" content={author} />
)}
{tags.map(tag => (
  <meta property="article:tag" content={tag} />
))}

<!-- JSON-LD Structured Data -->
{type === 'article' ? (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": finalDescription,
    "image": resolvedImage,
    "url": resolvedCanonical,
    "datePublished": pubDateObj?.toISOString(),
    "dateModified": (updatedDateObj ?? pubDateObj)?.toISOString(),
    "author": {
      "@type": "Person",
      "name": author,
      "url": `${siteUrl}/about`
    },
    "publisher": {
      "@type": "Organization",
      "name": "HotMamaTravel",
      "@id": `${siteUrl}/#organization`,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/images/hmt-logo.png`
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": resolvedCanonical
    }
  })} />
) : (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "HotMamaTravel",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/images/hmt-logo.png`
    },
    "sameAs": [
      "https://www.facebook.com/hotmamatravelblog",
      "https://twitter.com/hotmamatravel",
      "https://www.instagram.com/hotmamatravel",
      "https://www.youtube.com/@Hotmamatravel",
      "https://www.pinterest.com/hotmamatravel"
    ]
  })} />
)}
