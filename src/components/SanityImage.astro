---
// src/components/SanityImage.astro
import { getImageUrl, getImageSrcSet } from '@/utils/imageUrl';

const { node } = Astro.props;
const src = getImageUrl(node);
const srcset = getImageSrcSet(node);
const alt = node.alt || '';
---

{src && (
  <figure>
    <img
      src={src}
      srcset={srcset || undefined}
      sizes={srcset ? "(max-width: 640px) 100vw, 800px" : undefined}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
  </figure>
)}
