---
// src/components/LocalImage.astro
import { getImageUrl } from '@/utils/imageUrl';

interface Props {
  node: {
    src?: string;
    image?: any;
    alt: string;
    caption?: string;
    href?: string;
    pinDescription?: string;
  };
}

const { node } = Astro.props;
const { src, image, alt, caption, href, pinDescription } = node;

// Resolve image URL: if 'image' is uploaded to Sanity, resolve it, otherwise use 'src'
const resolvedSrc = image ? getImageUrl(image) : src;
---

{resolvedSrc && (
  <figure data-pin-description={pinDescription}>
    {href ? (
      <a href={href}>
        <img src={resolvedSrc} alt={alt} loading="lazy" decoding="async" data-pin-description={pinDescription} />
      </a>
    ) : (
      <img src={resolvedSrc} alt={alt} loading="lazy" decoding="async" data-pin-description={pinDescription} />
    )}
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
)}
