---
// src/pages/go/[...slug].astro — Handles ThirstyAffiliates redirects automatically
import { sanityClient } from 'sanity:client';

export async function getStaticPaths() {
  const redirects = await sanityClient.fetch(`*[_type == "affiliateLink"]`);
  return redirects.map((item: any) => ({
    params: { slug: item.slug },
    props: { destUrl: item.destUrl }
  }));
}

const { destUrl } = Astro.props;
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Redirecting...</title>
    <meta http-equiv="refresh" content={`0;url=${destUrl}`} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={destUrl} />
  </head>
  <body>
    <p>Redirecting you to <a href={destUrl}>{destUrl}</a>...</p>
    <script is:inline define:vars={{ destUrl }}>
      // Fallback Javascript redirect
      window.location.href = destUrl;
    </script>
  </body>
</html>
