---
// src/pages/[...slug].astro — Individual post pages fetched from Sanity
import { sanityClient } from 'sanity:client';
import PostLayout from '@/layouts/PostLayout.astro';
import { PortableText } from 'astro-portabletext';
import RawHtml from '@/components/RawHtml.astro';
import PortableTextHeading from '@/components/PortableTextHeading.astro';
import LocalImage from '@/components/LocalImage.astro';
import SanityImage from '@/components/SanityImage.astro';


export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post" && !draft]`);
  return posts.map((post) => ({
    params: { slug: post.slug.current },
    props: { post },
  }));
}

const { post } = Astro.props;

const customComponents = {
  type: {
    rawHtml: RawHtml,
    localImage: LocalImage,
    pinterestPin: LocalImage,
    image: SanityImage,
  },
  block: {
    h2: PortableTextHeading,
    h3: PortableTextHeading,
    h4: PortableTextHeading,
  },
};
---

<PostLayout post={post}>
  <PortableText value={post.body} components={customComponents} />
</PostLayout>
