---
// src/pages/tag/[tag].astro — Tag archive pages
// Replaces WordPress /category/ and /tag/ URLs with /tag/ (via vercel.json redirects)
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { sanityClient } from 'sanity:client';
import { slugifyTag } from '@/utils/slugify';

export async function getStaticPaths() {
  const allPosts = await sanityClient.fetch(
    `*[_type == "post" && !draft && !(slug.current in ["contact", "privacy-policy", "terms-of-use", "work-with-us", "disclosure-policy"])]`
  );

  // Collect all unique tags from all posts, including category as a tag
  const tagSet = new Set<string>();
  allPosts.forEach((post: any) => {
    post.tags?.forEach((tag: string) => tagSet.add(slugifyTag(tag)));
    if (post.category) {
      tagSet.add(slugifyTag(post.category));
    }
  });

  return Array.from(tagSet).map(tag => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts.filter((post: any) =>
        post.tags?.some((t: string) => slugifyTag(t) === tag) ||
        (post.category && slugifyTag(post.category) === tag)
      ).sort((a: any, b: any) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()),
    },
  }));
}

const { tag, posts } = Astro.props;
const displayTag = tag.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
---

<BaseLayout
  title={`${displayTag} — Family Travel Tips`}
  description={`Browse all HotMamaTravel articles about ${displayTag}. Real tips, honest reviews, and family-friendly guides.`}
>
  <div class="tag-header">
    <div class="container">
      <a href="/blog" class="tag-breadcrumb">← All Posts</a>
      <span class="badge" style="margin-bottom:12px">{displayTag}</span>
      <h1>{displayTag}</h1>
      <p>{posts.length} article{posts.length !== 1 ? 's' : ''}</p>
    </div>
  </div>

  <div class="container tag-body">
    {posts.length > 0 ? (
      <div class="post-grid">
        {posts.map(post => <PostCard post={post} />)}
      </div>
    ) : (
      <div class="no-posts">
        <p>No posts found in this category yet. <a href="/blog">Browse all posts →</a></p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .tag-header {
    background: var(--hmt-bg-section);
    border-bottom: 1px solid var(--hmt-border);
    padding: clamp(32px, 5vw, 56px) 0;
    text-align: center;
  }
  .tag-breadcrumb {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--hmt-muted);
    margin-bottom: 16px;
    transition: color var(--duration) var(--ease);
  }
  .tag-breadcrumb:hover { color: var(--hmt-red); }
  .tag-header h1 {
    font-size: clamp(1.6rem, 4vw, 2.25rem);
    margin: 8px 0;
  }
  .tag-header p { color: var(--hmt-muted); }

  .tag-body {
    padding-top: clamp(32px, 5vw, 56px);
    padding-bottom: 60px;
  }

  .no-posts {
    text-align: center;
    padding: 80px 0;
    color: var(--hmt-muted);
  }
  .no-posts a {
    color: var(--hmt-dark);
    font-weight: 400;
    text-decoration: underline;
    text-decoration-color: rgba(232, 35, 42, 0.3);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3.5px;
    transition: text-decoration-color var(--duration) var(--ease), text-decoration-thickness var(--duration) var(--ease);
  }
  .no-posts a:hover {
    text-decoration-color: var(--hmt-red);
    text-decoration-thickness: 3px;
  }
</style>
